generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth tables. The field names follow Better Auth's schema, plus the
// admin plugin's role/ban fields and our own branchId on the user.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Admin plugin. Role is "admin" or "staff".
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  // Branch staff work at exactly one branch. Admins have none and see every branch.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  sessions Session[]
  accounts Account[]

  studentsCreated    Student[]       @relation("StudentCreatedBy")
  enrollmentsCreated Enrollment[]    @relation("EnrollmentCreatedBy")
  paymentsRecorded   Payment[]       @relation("PaymentRecordedBy")
  expensesRecorded   Expense[]       @relation("ExpenseRecordedBy")
  budgetsSaved       MonthlyBudget[] @relation("BudgetSavedBy")

  @@unique([email])
  @@index([branchId])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// College
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Digits only, in WhatsApp's form: see Student.phone.
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        User[]
  classrooms   Classroom[]
  teachers     TeacherBranch[]
  branchSkills BranchSkill[]
  homeStudents Student[]
  payments     Payment[]
  expenses     Expense[]
  budgets      MonthlyBudget[]

  @@map("branches")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills Skill[]

  @@map("categories")
}

/// One entry in the college-wide catalog. Head office owns it; every branch
/// shares it. Branch-specific details (teacher, class, fees, duration) live on
/// BranchSkill. The duration and fees here are only the defaults a branch
/// starts from when the skill is added to it.
model Skill {
  id              String   @id @default(cuid())
  name            String   @unique
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  durationMonths  Int
  /// Paid once for every enrollment in the skill, on top of the monthly fee.
  registrationFee Decimal  @db.Decimal(10, 2)
  monthlyFee      Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branchSkills BranchSkill[]
  enrollments  Enrollment[]

  @@index([categoryId])
  @@map("skills")
}

/// A room at a branch. The screens call it a "Class", which is the college's word for it.
model Classroom {
  id        String   @id @default(cuid())
  name      String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchSkills BranchSkill[]

  @@unique([branchId, name])
  @@map("classrooms")
}

model Teacher {
  id             String     @id @default(cuid())
  name           String
  /// Digits only, in WhatsApp's form: see Student.phone.
  phone          String?
  /// How this teacher is paid. FIXED uses fixedSalary; PERCENTAGE earns a
  /// share of every monthly fee paid for the skills they teach.
  salaryType     SalaryType @default(FIXED)
  /// What a FIXED teacher is paid each month. Null for a PERCENTAGE teacher.
  fixedSalary    Decimal?   @db.Decimal(10, 2)
  /// A PERCENTAGE teacher's share, as a percentage: 30 means 30%. Null for
  /// a FIXED teacher.
  percentageRate Decimal?   @db.Decimal(5, 2)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  branches     TeacherBranch[]
  branchSkills BranchSkill[]
  payments     Payment[]
  payouts      Expense[]

  @@map("teachers")
}

/// A teacher can work at several branches without being entered twice.
model TeacherBranch {
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id])

  @@id([teacherId, branchId])
  @@index([branchId])
  @@map("teacher_branches")
}

/// A skill as it runs at one branch: one teacher, one class, and the fees and
/// duration that branch charges. A branch in a poorer city can charge less.
/// Students enroll in this, not in the catalog skill directly.
model BranchSkill {
  id              String    @id @default(cuid())
  skillId         String
  skill           Skill     @relation(fields: [skillId], references: [id])
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id])
  teacherId       String
  teacher         Teacher   @relation(fields: [teacherId], references: [id])
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id])
  durationMonths  Int
  /// Paid once for every enrollment here, on top of the monthly fee.
  registrationFee Decimal   @db.Decimal(10, 2)
  monthlyFee      Decimal   @db.Decimal(10, 2)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enrollments Enrollment[]

  @@unique([skillId, branchId])
  @@index([branchId])
  @@map("branch_skills")
}

enum Sex {
  MALE
  FEMALE
}

/// A student belongs to the whole college. The home branch is where they
/// registered; they can still take skills at any branch.
model Student {
  id               String   @id @default(cuid())
  /// Shown as STU-00001. One sequence for the whole college.
  number           Int      @unique @default(autoincrement())
  fullName         String
  /// Digits only, country code and all, the way WhatsApp takes a number:
  /// "252611111111". The screens print it as +252 61 1111111.
  phone            String?
  sex              Sex
  /// The responsible person's phone, in the same form.
  responsiblePhone String?
  photoUrl         String?
  photoPublicId    String?
  registrationDate DateTime @db.Date
  homeBranchId     String
  homeBranch       Branch   @relation(fields: [homeBranchId], references: [id])
  createdById      String
  createdBy        User     @relation("StudentCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollments Enrollment[]
  payments    Payment[]

  @@index([homeBranchId])
  @@index([phone])
  @@index([responsiblePhone])
  @@map("students")
}

enum EnrollmentStatus {
  ACTIVE
  FINISHED
  DROPPED
}

/// One student taking one skill at one branch. A student is Active while any
/// of their enrollments is ACTIVE; there is no stored student status.
model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branchSkillId   String
  branchSkill     BranchSkill      @relation(fields: [branchSkillId], references: [id])
  /// Copied from the branch skill so the database itself can refuse a second
  /// active enrollment in the same skill, even across branches.
  skillId         String
  skill           Skill            @relation(fields: [skillId], references: [id])
  startDate       DateTime         @db.Date
  /// Start date plus the branch skill's duration. A guide only: staff mark the
  /// enrollment Finished themselves.
  endDate         DateTime         @db.Date
  /// The branch skill's monthly fee on the day the student joined.
  monthlyFee      Decimal          @db.Decimal(10, 2)
  /// The branch skill's registration fee on the day the student joined, unless the
  /// admin lowered or waived it since. Zero means there's nothing to pay.
  /// Whether it was paid is the payment in the ledger, not a field here.
  registrationFee Decimal          @db.Decimal(10, 2)
  status          EnrollmentStatus @default(ACTIVE)
  statusChangedAt DateTime?
  createdById     String
  createdBy       User             @relation("EnrollmentCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  payments Payment[]

  @@unique([studentId, skillId], where: raw("status = 'ACTIVE'"), map: "enrollments_one_active_per_skill")
  @@index([studentId])
  @@index([branchSkillId, status])
  @@index([skillId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// Money
//
// Every dollar the college takes in is one Payment; every dollar it spends is
// one Expense. Both name the branch they happened at and the day they
// happened, which is what the daily and monthly figures are built from.
// ---------------------------------------------------------------------------

/// How money changed hands. ZAAD and eDahab are the mobile money services.
enum PaymentMethod {
  CASH
  ZAAD
  EDAHAB
  BANK
}

/// What a payment was for. The first two are tied to an enrollment and are
/// recorded from the student's page; the rest are entered on their own.
enum IncomeCategory {
  REGISTRATION_FEE
  MONTHLY_FEE
  BOOKS
  EXAMINATION_FEE
  OTHER
}

enum ExpenseCategory {
  RENT
  ELECTRICITY
  TEACHER_SALARY
  STAFF_SALARY
  INTERNET
  STATIONERY
  TRANSPORTATION
  MAINTENANCE
  OTHER
}

enum SalaryType {
  FIXED
  PERCENTAGE
}

/// Money received, whatever it was for. A registration fee is one of these,
/// and so is each month a student pays for a skill.
model Payment {
  id       String         @id @default(cuid())
  /// Shown on receipts as PAY-00001. One sequence for the whole college.
  number   Int            @unique @default(autoincrement())
  category IncomeCategory
  method   PaymentMethod
  amount   Decimal        @db.Decimal(10, 2)
  /// The college day the money came in. Daily income counts by this, not by
  /// createdAt: a payment taken on Friday may be entered on Saturday.
  paidOn   DateTime       @db.Date
  /// Where the money was taken. For a fee it's the branch teaching the skill.
  branchId String
  branch   Branch         @relation(fields: [branchId], references: [id])

  /// Set for anything a student pays. Null for income with no student behind
  /// it, like a book sold over the counter.
  studentId    String?
  student      Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Set for a registration fee or a monthly fee, which are always for one skill.
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// The month a MONTHLY_FEE covers, as that month's first day. This is what
  /// says September is paid and October isn't, whenever the money arrived.
  forMonth     DateTime?   @db.Date

  /// The teacher this payment earned a share for, set only when the skill's
  /// teacher is paid by percentage. The rate and the share are worked out
  /// once, here, so a later rate change never rewrites what was earned.
  teacherId           String?
  teacher             Teacher? @relation(fields: [teacherId], references: [id])
  teacherSharePercent Decimal? @db.Decimal(5, 2)
  teacherShare        Decimal? @db.Decimal(10, 2)

  note         String?
  recordedById String
  recordedBy   User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  /// A registration fee is paid once per enrollment, and a monthly fee once
  /// per month per enrollment. The database refuses a second one, so a
  /// double click can't charge a student twice.
  @@unique([enrollmentId], where: raw("category = 'REGISTRATION_FEE'"), map: "payments_one_registration_fee")
  @@unique([enrollmentId, forMonth], where: raw("category = 'MONTHLY_FEE'"), map: "payments_one_monthly_fee_per_month")
  @@index([paidOn])
  @@index([branchId, paidOn])
  @@index([category, paidOn])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([teacherId])
  @@map("payments")
}

/// Money spent. A teacher's salary and a percentage teacher's payout are both
/// expenses in the TEACHER_SALARY category, with the teacher named.
model Expense {
  id       String          @id @default(cuid())
  number   Int             @unique @default(autoincrement())
  category ExpenseCategory
  method   PaymentMethod
  amount   Decimal         @db.Decimal(10, 2)
  /// The college day the money went out.
  spentOn  DateTime        @db.Date
  branchId String
  branch   Branch          @relation(fields: [branchId], references: [id])

  /// Set on a salary or payout so a teacher's pay can be traced.
  teacherId String?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id])
  /// The month a salary covers, as that month's first day.
  forMonth  DateTime? @db.Date

  note         String?
  recordedById String
  recordedBy   User     @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([spentOn])
  @@index([branchId, spentOn])
  @@index([category, spentOn])
  @@index([teacherId])
  @@map("expenses")
}

/// One branch's plan for one month, written before the month is spent. What
/// actually happened is never stored here: it's counted from the payments and
/// expenses, so the comparison always matches the ledger.
model MonthlyBudget {
  id       String   @id @default(cuid())
  branchId String
  branch   Branch   @relation(fields: [branchId], references: [id])
  /// The month being planned, as that month's first day.
  month    DateTime @db.Date

  expectedIncome Decimal @db.Decimal(10, 2)
  note           String?

  savedById String
  savedBy   User     @relation("BudgetSavedBy", fields: [savedById], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines MonthlyBudgetLine[]

  @@unique([branchId, month])
  @@index([month])
  @@map("monthly_budgets")
}

/// What one expense category was budgeted for in one month. A category with
/// no line wasn't planned for; spending on it still shows up as unplanned.
model MonthlyBudgetLine {
  budgetId String
  budget   MonthlyBudget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category ExpenseCategory
  amount   Decimal         @db.Decimal(10, 2)

  @@id([budgetId, category])
  @@map("monthly_budget_lines")
}
