# Neon Postgres. DATABASE_URL is the pooled connection the app uses at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection, used only by the Prisma CLI for migrations.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# Optional. Set to 1 when using the local `prisma dev` database, which takes one connection at a time.
DATABASE_POOL_MAX=""
# Optional. Only for `prisma migrate dev` against the local `prisma dev` database:
# postgres://postgres:postgres@localhost:51215/template1?sslmode=disable
SHADOW_DATABASE_URL=""

# Better Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary, for student photos. Leave empty to turn photo upload off.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# First admin account, created by: pnpm db:seed
SEED_ADMIN_NAME="College Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
